# ---------- Dockerfile.dev ----------
    FROM node:20-alpine

    # Set working directory
    WORKDIR /app
    
    # Copy package files
    COPY package*.json ./
    
    # Install all deps (dev included)
    RUN npm install
    
    # Copy rest of app
    COPY . .
    
    # Expose port
    EXPOSE 3000
    
    # Default command for dev (with hot reload)
    CMD ["npm", "run", "dev"]
    